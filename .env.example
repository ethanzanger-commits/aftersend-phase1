cd apps/api
printf 'Paste your NEW Supabase secret key, then press Enter (it stays hidden): '
read -s KEY; echo
cat > .env.local <<EOF
SUPABASE_URL=https://bpwmivmqndtnxfuyiwvn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=$KEY
TRACKING_BASE_URL=http://localhost:3000
IP_HASH_SALT=$(openssl rand -hex 32)
CRON_SECRET=$(openssl rand -hex 32)
ALLOWED_EXTENSION_ORIGINS=chrome-extension://replace-with-your-extension-id
EOF
unset KEY
cd ../..
npm install
npm run dev -w @aftersend/api

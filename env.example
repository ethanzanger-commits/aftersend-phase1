# ===== SERVER ONLY (Vercel project env vars; apps/api) =====
# NEVER prefix these with NEXT_PUBLIC_ and NEVER bundle them into the extension.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Public base URL used in pixel/link/landing-page URLs
TRACKING_BASE_URL=https://your-app.vercel.app
# Random 32+ byte secret for hashing IPs (rotate periodically): openssl rand -hex 32
IP_HASH_SALT=replace-me
# Shared secret that protects the retention-purge cron endpoint: openssl rand -hex 32
CRON_SECRET=replace-me
# Comma-separated list of allowed extension origins for the event/registration API
ALLOWED_EXTENSION_ORIGINS=chrome-extension://replace-with-your-extension-id

# ===== EXTENSION BUILD-TIME (public by design; anon key only) =====
EXT_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXT_SUPABASE_ANON_KEY=replace-me
EXT_API_BASE_URL=https://your-app.vercel.app
